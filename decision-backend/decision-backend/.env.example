# DecisionMate 后端环境变量示例
#
# 复制为 .env 后填入真实值（.env 已被 gitignore，切勿提交）。
#   复制：copy .env.example .env        （Windows）
#         cp .env.example .env          （Linux/macOS）

# ---- 必填 ----
# 对话模型（DeepSeek 官方接口）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 向量嵌入（SiliconFlow，模型 BAAI/bge-large-zh-v1.5）
# 用于历史相似决策检索；缺失时检索会降级为「无历史参考」，不影响决策本身。
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 可选 ----
# 访问令牌。留空/不写 = 不鉴权（默认，适合本机或可信局域网自用）。
# 一旦在共享局域网部署，建议设置一段随机字符串，并在前端「设置」页填入同一串字符。
# DM_AUTH_TOKEN=

# 数据落点覆盖（一般无需设置；测试与批量跑测靠它隔离副本）
# DECISION_DB_PATH=decision.db
# CHROMA_DB_PATH=chroma_db

# 说明：模型名与 base_url 目前硬编码在 agent_core/ai_client.py 与 vector_store.py，
# 不通过环境变量配置。
